# Upload only the website container inputs to Vercel.
**
!.dockerignore
!vercel.json
!Dockerfile
!Dockerfile.vercel
!deploy/
!deploy/nginx.conf
!frontend/
!frontend/**

# Keep dependencies, local settings, and generated builds out of the context.
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.*
frontend/**/.env
frontend/**/.env.*
frontend/.vercel/
frontend/**/.DS_Store
frontend/**/*.log
frontend/**/*.tsbuildinfo
